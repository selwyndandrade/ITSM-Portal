{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"customTemplates": [
		{
			"name": "blank",
			"postTypes": [
				"page"
			],
			"title": "Blank template"
		},
		{
			"name": "single-uk-project",
			"postTypes": [
				"none"
			],
			"title": "Single projects"
		},
		{
			"name": "archive-uk-project",
			"postTypes": [
				"none"
			],
			"title": "Portfolio"
		},
		{
			"name": "taxonomy-uk-project_category",
			"postTypes": [
				"none"
			],
			"title": "Portfolio category archive"
		},
		{
			"name": "taxonomy-uk-project_tag",
			"postTypes": [
				"none"
			],
			"title": "Portfolio tag archive"
		}
