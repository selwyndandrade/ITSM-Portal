								"file:./assets/fonts/inter/InterVariable-Italic.woff2"
							]
						}
					],
					"fontFamily": "Inter, sans-serif",
					"name": "Inter",
					"slug": "font-primary"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Azeret Mono",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/azeret-mono/AzeretMono-Variable.woff2"
							]
						}
					],
					"fontFamily": "\"Azeret Mono\", monospace",
					"name": "Azeret Mono",
					"slug": "font-monospace"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "2X Small",
					"size": "0.75rem",
					"slug": "xx-small"
				},
				{
					"fluid": false,
					"name": "Extra Small",
					"size": "0.8125rem",
					"slug": "x-small"
				},
				{
					"fluid": false,
