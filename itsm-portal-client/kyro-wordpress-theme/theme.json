					"slug": "normal"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1.125rem"
					},
					"name": "Medium",
					"size": "1.125rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.3125rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.3125rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "1.5rem",
						"min": "1.3125rem"
					},
					"name": "Extra Large",
					"size": "1.5rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "1.875rem",
						"min": "1.5rem"
					},
					"name": "2X Large",
					"size": "1.875rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"max": "2.25rem",
						"min": "1.875rem"
					},
					"name": "3X Large",
					"size": "2.25rem",
					"slug": "xxx-large"
				},
				{
					"fluid": {
						"max": "3.75rem",
						"min": "2.25rem"
					},
					"name": "Huge",
					"size": "3.75rem",
					"slug": "huge"
				},
				{
					"fluid": {
						"max": "6.75rem",
						"min": "2.25rem"
					},
					"name": "Display",
					"size": "6.75rem",
					"slug": "display"
				}
			],
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true
