	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#0a0a0a",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "color-mix(in srgb, #0a0a0a 95%, transparent)",
					"name": "Contrast / Two",
					"slug": "contrast-2"
				},
				{
					"color": "color-mix(in srgb, #0a0a0a 57%, transparent)",
					"name": "Contrast / Three",
					"slug": "contrast-3"
				},
				{
					"color": "color-mix(in srgb, #0a0a0a 14%, transparent)",
					"name": "Contrast / Four",
					"slug": "contrast-4"
				},
				{
					"color": "color-mix(in srgb, #0a0a0a 2%, transparent)",
					"name": "Contrast / Five",
					"slug": "contrast-5"
				},
				{
					"color": "#f4f4f4",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#df042d",
					"name": "Danger",
					"slug": "danger"
				}
			]
		},
		"custom": {
			"border": {
				"radius": "0.25rem"
			},
			"color": {
				"background": "var(--wp--preset--color--accent)",
				"base": "#0a0a0a",
				"contrast": "#ffffff",
				"contrast-2": "color-mix(in srgb, #ffffff 75%, transparent)",
				"contrast-3": "color-mix(in srgb, #ffffff 47%, transparent)",
				"contrast-4": "color-mix(in srgb, #ffffff 15%, transparent)",
				"contrast-5": "color-mix(in srgb, #ffffff 3%, transparent)",
				"cursor": "var(--wp--preset--color--base)",
				"sidebar": {
					"background": "var(--wp--preset--color--accent)"
				}
			},
			"typography": {
				"fontFeatureSettings": "\"cv10\", \"ss03\", \"cv01\", \"cv09\", \"cv03\", \"cv04\"",
				"fontVariationSettings": "\"opsz\" 25",
				"letterSpacing": {
					"display": "calc(-1 * clamp(0.015em, 0.3vw, 0.04em))",
					"huge": "calc(-1 * clamp(0.015em, 0.2vw, 0.03em))",
					"large": "-0.003em",
					"medium": "-0.003em",
					"normal": "0",
					"small": "0",
					"x-large": "-0.01em",
					"x-small": "0",
					"xx-large": "-0.01em",
					"xx-small": "0",
					"xxx-large": "-0.015em"
				},
				"lineHeight": {
					"display": "clamp(2.625rem, 5.46875vi + 1.53125rem, 7rem)",
					"huge": "clamp(2.625rem, 1.875vw + 2.25rem, 4.125rem)",
					"large": "clamp(1.625rem, 0.15625vw + 1.59375rem, 1.75rem)",
					"medium": "1.38889",
					"normal": "1.5",
					"small": "1.5",
					"x-large": "clamp(1.75rem, 0.3125vw + 1.6875rem, 2rem)",
					"x-small": "1.5",
					"xx-large": "clamp(1.875rem, 0.625vw + 1.75rem, 2.375rem)",
					"xx-small": "1.5",
					"xxx-large": "clamp(2.25rem, 0.46875vw + 2.15625rem, 2.625rem)"
				}
			}
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "100%"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Regular",
					"size": "var(--wp--style--block-gap)",
					"slug": "10"
				},
				{
					"name": "Medium",
					"size": "clamp(2.25rem, 0.9375vw + 2.0625rem, 3rem)",
					"slug": "20"
				},
				{
					"name": "Large",
					"size": "clamp(3rem, 1.875vw + 2.625rem, 4.5rem)",
					"slug": "30"
				},
				{
					"name": "X-Large",
					"size": "clamp(3.75rem, 2.8125vi + 3.1875rem, 6rem)",
					"slug": "40"
				},
				{
					"name": "2X-Large",
					"size": "clamp(4.5rem, 3.75vw + 3.75rem, 7.5rem)",
					"slug": "50"
				},
				{
					"name": "3X-Large",
					"size": "clamp(6rem, 5.625vw + 4.875rem, 10.5rem)",
					"slug": "60"
				},
				{
					"name": "Huge",
					"size": "max(13.5rem, 20vw)",
					"slug": "70"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"ch"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/inter/InterVariable.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "100 900",
